# ── Ollama (local model) ──────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b has the best tool-calling support — pull it with: ollama pull qwen2.5:7b
# mistral-nemo:latest is already on your machine and also supports tool calling
RESEARCHER_MODEL=mistral-nemo:latest
LLM_TIMEOUT=90

# ── Thingiverse API ──────────────────────────────────────────────────────────
# Register at https://www.thingiverse.com/developers — create an app to get these
THINGIVERSE_TOKEN=
THINGIVERSE_APP_ID=
THINGIVERSE_APP_SECRET=

# ── eBay Research API (optional) ─────────────────────────────────────────────
# Register a free developer account at https://developer.ebay.com
# Create an application → get App ID (Client ID) and Cert ID (Client Secret)
EBAY_APP_ID=
EBAY_CERT_ID=
# Use 'sandbox' for testing, 'production' for live data
EBAY_ENV=production

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8009
# Bind address — 127.0.0.1 restricts to localhost only (recommended).
# Set HOST=0.0.0.0 only if running behind a trusted reverse proxy.
HOST=127.0.0.1
# Optional API key — if set, all endpoints (except /, /health, /ui, /api-config)
# require the header:  X-Api-Key: <your-key>
# Leave empty to disable key enforcement (localhost binding is still active).
API_KEY=
