[Unit]
Description=THE RESEARCHER — Local Ollama Research Agent
Documentation=https://github.com/mrsuperfuntime/the-agentic-office
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
# Filled in by scripts/install.sh
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8009
Restart=on-failure
RestartSec=5
EnvironmentFile=__PROJECT_DIR__/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=researcher

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__PROJECT_DIR__

[Install]
WantedBy=multi-user.target
