#cloud-config
autoinstall:
  version: 1

  # ── Locale / keyboard ───────────────────────────────────────────────────────
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ── Network (DHCP on all interfaces) ────────────────────────────────────────
  network:
    version: 2
    ethernets:
      enp: {}   # catch-all glob for any ethernet NIC name
    wifis: {}

  # ── User account ────────────────────────────────────────────────────────────
  identity:
    hostname: {{HOSTNAME}}
    username: {{USERNAME}}
    # SHA-512 crypt hash — generated by build-usb.ps1 via openssl passwd -6
    password: "{{PASSWORD_HASH}}"

  # ── SSH ──────────────────────────────────────────────────────────────────────
  ssh:
    install-server: true
    allow-pw: true

  # ── Storage (whole-disk LVM, wipes everything) ───────────────────────────────
  storage:
    layout:
      name: lvm
      match:
        # Pick the largest local disk that is NOT the USB installer
        size: largest

  # ── Packages installed before first boot ────────────────────────────────────
  packages:
    - curl
    - git
    - build-essential
    - python3.11
    - python3.11-venv
    - python3.11-dev
    - net-tools
    - htop
    - ufw

  # ── Commands run inside the installer (chroot) after package install ────────
  late-commands:
    # Allow {{USERNAME}} passwordless sudo so bootstrap.sh can run unattended
    - |
      echo '{{USERNAME}} ALL=(ALL) NOPASSWD:ALL' \
        > /target/etc/sudoers.d/researcher-bootstrap
    - chmod 440 /target/etc/sudoers.d/researcher-bootstrap

    # Copy bootstrap.sh from the installer USB into the new system
    # The USB is still mounted at /cdrom during late-commands
    - |
      if [ -f /cdrom/autoinstall/bootstrap.sh ]; then
        cp /cdrom/autoinstall/bootstrap.sh /target/usr/local/bin/researcher-bootstrap.sh
        chmod +x /target/usr/local/bin/researcher-bootstrap.sh
      fi

    # Install a systemd one-shot service that runs bootstrap.sh on first login
    - |
      cat > /target/etc/systemd/system/researcher-firstboot.service << 'UNIT'
      [Unit]
      Description=THE RESEARCHER — first-boot setup
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/var/lib/.researcher-bootstrapped

      [Service]
      Type=oneshot
      User={{USERNAME}}
      WorkingDirectory=/home/{{USERNAME}}
      Environment=UNATTENDED=true
      ExecStart=/usr/local/bin/researcher-bootstrap.sh
      ExecStartPost=/bin/touch /var/lib/.researcher-bootstrapped
      RemainAfterExit=yes
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target
      UNIT

    - systemctl --root=/target enable researcher-firstboot.service

  # ── Disable interactive update-manager prompt after install ─────────────────
  updates: security

  # ── Confirm destructive operation ────────────────────────────────────────────
  # (Required — tells subiquity it's OK to wipe the disk)
  confirm-destructive-action: yes
