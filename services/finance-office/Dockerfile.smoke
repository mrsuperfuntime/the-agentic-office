FROM python:3.11-slim

WORKDIR /app

COPY services/finance-office/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY services/finance-office/ ./services/finance-office/
COPY shared/ ./shared/

WORKDIR /app/services/finance-office

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
