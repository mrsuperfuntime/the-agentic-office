# ============================================
# LLM Configuration
# ============================================

# Primary LLM Provider (ollama or groq)
LLM_PRIMARY_PROVIDER=ollama

# Fallback LLM Provider (groq or ollama)
LLM_FALLBACK_PROVIDER=groq

# Enable fallback to secondary provider
LLM_ENABLE_FALLBACK=false

# Strict local profile (fail fast if Ollama/model unavailable)
LLM_STRICT_LOCAL=true

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Groq Configuration
# Keep empty for strict local profile
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30

# ============================================
# Database Configuration
# ============================================

POSTGRES_USER=agentic
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=agentic_office
DATABASE_URL=postgresql://agentic:replace_with_strong_postgres_password@postgres:5432/agentic_office

# ============================================
# Message Queue Configuration
# ============================================

RABBITMQ_DEFAULT_USER=agentic
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
RABBITMQ_URL=amqp://agentic:replace_with_strong_rabbitmq_password@rabbitmq:5672

# ============================================
# Service Configuration
# ============================================

SERVICE_NAME=agentic-office
ENVIRONMENT=development
LOG_LEVEL=INFO
ORCHESTRATOR_API_KEY=replace_with_minimum_16_char_api_key
ORCHESTRATOR_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================
# Office-Specific Settings (Optional)
# ============================================

# Sales Office
SALES_OFFICE_NAME=Sales Office
SALES_FORECAST_PERIOD=Q4

# HR Office
HR_OFFICE_NAME=HR Office
HR_HIRING_BUDGET=500000

# Customer Service Office
CUSTOMER_SERVICE_OFFICE_NAME=Customer Service Office
CS_MAX_RESPONSE_TIME=300

# Procurement Office
PROCUREMENT_OFFICE_NAME=Procurement Office
PROCUREMENT_BUDGET=1000000

# Finance Office
FINANCE_OFFICE_NAME=Finance Office
FINANCE_BUDGET_LIMIT=5000000

# Manufacturing Office
MANUFACTURING_OFFICE_NAME=Manufacturing Office
MFG_PRODUCTION_CAPACITY=1000

# Social Media Office
SOCIAL_MEDIA_OFFICE_NAME=Social Media Office
SOCIAL_MEDIA_PLATFORMS=twitter,linkedin,instagram,tiktok,facebook
